:34.455" end="8:34.595" podcasts:unit="word">auch</span><span begin="8:34.615" end="8:34.855" podcasts:unit="word">was</span><span begin="8:34.875" end="8:36.235" podcasts:unit="word">Anekdotisches.</span></span><span begin="8:36.255" end="8:49.655" podcasts:unit="sentence"><span begin="8:36.255" end="8:36.355" podcasts:unit="word">Ich</span><span begin="8:36.375" end="8:36.875" podcasts:unit="word">hatte</span><span begin="8:36.895" end="8:36.995" podcasts:unit="word">in</span><span begin="8:37.015" end="8:37.235" podcasts:unit="word">den</span><span begin="8:37.255" end="8:37.715" podcasts:unit="word">vergangenen</span><span begin="8:37.735" end="8:38.195" podcasts:unit="word">Jahren,</span><span begin="8:38.215" end="8:38.355" podcasts:unit="word">wenn</span><span begin="8:38.375" end="8:38.475" podcasts:unit="word">ich</span><span begin="8:38.495" end="8:38.675" podcasts:unit="word">mal</span><span begin="8:38.695" end="8:39.035" podcasts:unit="word">E-Mails</span><span begin="8:39.055" end="8:39.235" podcasts:unit="word">oder</span><span begin="8:39.255" end="8:39.375" podcasts:unit="word">so</span><span begin="8:39.395" end="8:40.595" podcasts:unit="word">bekomme,</span><span begin="8:40.615" end="8:41.755" podcasts:unit="word">von</span><span begin="8:41.775" end="8:42.335" podcasts:unit="word">Zuschauern</span><span begin="8:42.355" end="8:42.575" podcasts:unit="word">immer</span><span begin="8:42.595" end="8:42.815" podcasts:unit="word">wieder</span><span begin="8:42.855" end="8:43.495" podcasts:unit="word">mal</span><span begin="8:43.515" end="8:43.695" podcasts:unit="word">diese</span><span begin="8:43.715" end="8:44.035" podcasts:unit="word">Formulierung,</span><span begin="8:45.595" end="8:45.795" podcasts:unit="word">ich</span><span begin="8:45.815" end="8:46.115" podcasts:unit="word">habe</span><span begin="8:46.135" end="8:46.315" podcasts:unit="word">nicht</span><span begin="8:46.335" end="8:46.835" podcasts:unit="word">studiert,</span><span begin="8:46.855" end="8:47.415" podcasts:unit="word">aber,</span><span begin="8:47.435" end="8:47.675" podcasts:unit="word">oder</span><span begin="8:47.695" end="8:47.935" podcasts:unit="word">fast</span><span begin="8:47.955" end="8:48.035" podcasts:unit="word">so</span><span begin="8:48.055" end="8:48.795" podcasts:unit="word">etwas</span><span begin="8:48.815" end="8:49.655" podcasts:unit="word">Entschuldigendes.</span></span><span begin="8:49.955" end="8:50.895" podcasts:unit="sentence"><span begin="8:49.955" end="8:50.135" podcasts:unit="word">Ich</span><span begin="8:50.155" end="8:50.335" podcasts:unit="word">bin</span><span begin="8:50.355" end="8:50.455" podcasts:unit="word">noch</span><span begin="8:50.475" end="8:50.595" podcasts:unit="word">ein</span><span begin="8:50.615" end="8:50.895" podcasts:unit="word">Berger.</span></span><span begin="8:51.015" end="8:56.375" podcasts:unit="sentence"><span begin="8:51.015" end="8:51.175" podcasts:unit="word">Wo</span><span begin="8:51.195" end="8:51.255" podcasts:unit="word">ich</span><span begin="8:51.275" end="8:51.495" podcasts:unit="word">immer</span><span begin="8:51.515" end="8:52.535" podcasts:unit="word">gleich</span><span begin="8:52.555" end="8:53.035" podcasts:unit="word">drauf</span><span begin="8:53.055" end="8:53.395" podcasts:unit="word">geantwortet</span><span begin="8:53.415" end="8:53.555" podcasts:unit="word">habe,</span><span begin="8:53.575" end="8:53.715" podcasts:unit="word">dass</span><span begin="8:53.735" end="8:53.895" podcasts:unit="word">es</span><span begin="8:53.915" end="8:54.215" podcasts:unit="word">sich</span><span begin="8:54.235" end="8:54.375" podcasts:unit="word">da</span><span begin="8:54.395" end="8:54.575" podcasts:unit="word">nicht</span><span begin="8:54.595" end="8:54.715" podcasts:unit="word">zu</span><span begin="8:54.735" end="8:55.615" podcasts:unit="word">Entschuldigung</span><span begin="8:55.635" end="8:56.375" podcasts:unit="word">gibt.</span></span><span begin="8:56.