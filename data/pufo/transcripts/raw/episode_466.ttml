:46:20.040" end="2:46:20.500" podcasts:unit="word">responded</span><span begin="2:46:20.500" end="2:46:20.600" podcasts:unit="word">to.</span></span><span begin="2:46:20.600" end="2:46:26.800" podcasts:unit="sentence" xml:lang="en"><span begin="2:46:20.600" end="2:46:20.760" podcasts:unit="word">I'll</span><span begin="2:46:20.760" end="2:46:20.900" podcasts:unit="word">say,</span><span begin="2:46:20.900" end="2:46:21.320" podcasts:unit="word">well,</span><span begin="2:46:21.320" end="2:46:21.580" podcasts:unit="word">the</span><span begin="2:46:21.580" end="2:46:21.940" podcasts:unit="word">scripture</span><span begin="2:46:21.940" end="2:46:22.180" podcasts:unit="word">doesn't</span><span begin="2:46:22.180" end="2:46:22.360" podcasts:unit="word">talk</span><span begin="2:46:22.360" end="2:46:22.580" podcasts:unit="word">about</span><span begin="2:46:22.580" end="2:46:23.200" podcasts:unit="word">dinosaurs</span><span begin="2:46:23.300" end="2:46:23.420" podcasts:unit="word">or</span><span begin="2:46:23.420" end="2:46:23.780" podcasts:unit="word">duck-billed</span><span begin="2:46:23.780" end="2:46:24.300" podcasts:unit="word">platypi</span><span begin="2:46:24.300" end="2:46:25.020" podcasts:unit="word">or</span><span begin="2:46:25.020" end="2:46:25.380" podcasts:unit="word">microbes</span><span begin="2:46:25.380" end="2:46:25.480" podcasts:unit="word">or</span><span begin="2:46:25.480" end="2:46:25.940" podcasts:unit="word">molecules,</span><span begin="2:46:25.940" end="2:46:26.080" podcasts:unit="word">but</span><span begin="2:46:26.080" end="2:46:26.160" podcasts:unit="word">we</span><span begin="2:46:26.160" end="2:46:26.300" podcasts:unit="word">know</span><span begin="2:46:26.300" end="2:46:26.440" podcasts:unit="word">they</span><span begin="2:46:26.440" end="2:46:26.800" podcasts:unit="word">exist.</span></span><span begin="2:46:26.800" end="2:46:32.000" podcasts:unit="sentence" xml:lang="en"><span begin="2:46:26.800" end="2:46:27.220" podcasts:un