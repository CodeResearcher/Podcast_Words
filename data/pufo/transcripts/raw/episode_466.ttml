unit="word">Ecumenical</span><span begin="2:52:40.460" end="2:52:40.800" podcasts:unit="word">Council,</span><span begin="2:52:40.880" end="2:52:40.900" podcasts:unit="word">a</span><span begin="2:52:40.900" end="2:52:41.100" podcasts:unit="word">great</span><span begin="2:52:41.100" end="2:52:42.180" podcasts:unit="word">council</span><span begin="2:52:42.180" end="2:52:42.360" podcasts:unit="word">of</span><span begin="2:52:42.360" end="2:52:43.360" podcasts:unit="word">Basel.</span></span><span begin="2:52:44.480" end="2:52:49.200" podcasts:unit="sentence" xml:lang="en"><span begin="2:52:44.480" end="2:52:44.640" podcasts:unit="word">And</span><span begin="2:52:44.640" end="2:52:44.780" podcasts:unit="word">he</span><span begin="2:52:44.780" end="2:52:44.940" podcasts:unit="word">wrote</span><span begin="2:52:44.940" end="2:52:45.520" podcasts:unit="word">openly</span><span begin="2:52:45.520" end="2:52:45.820" podcasts:unit="word">about</span><span begin="2:52:45.820" end="2:52:46.180" podcasts:unit="word">this</span><span begin="2:52:46.180" end="2:52:46.300" podcasts:unit="word">and</span><span begin="2:52:46.300" end="2:52:46.600" podcasts:unit="word">about</span><span begin="2:52:46.600" end="2:52:46.740" podcasts:unit="word">how</span><span begin="2:52:46.740" end="2:52:46.860" podcasts:unit="word">he</span><span begin="2:52:46.860" end="2:52:47.940" podcasts:unit="word">thought</span><span begin="2:52:47.940" end="2:52:48.100" podcasts:unit="word">there</span><span begin="2:52:48.100" end="2:52:48.400" podcasts:unit="word">probably</span><span begin="2:52:48.400" end="2:52:48.520" podcasts:unit="word">is</span><span begin="2:52:48.520" end="2:52:48.980" podcasts:unit="word">intelligent</span><span begin="2:52:48.980" end="2:52:49.200" podcasts:unit="word">life.</span></span><span begin="2:52:49.200" end="2:52:54.180" podcasts:unit="sentence" xml:lang="en"><span begin="2:52:49.200" end="2:52:49.360" podcasts:unit="word">He</span><span begin="2:52:49.360" en