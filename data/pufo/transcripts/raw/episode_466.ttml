0" end="2:24:42.040" podcasts:unit="sentence" xml:lang="en"><span begin="2:24:34.920" end="2:24:35.020" podcasts:unit="word">And</span><span begin="2:24:35.020" end="2:24:35.140" podcasts:unit="word">all</span><span begin="2:24:35.140" end="2:24:35.240" podcasts:unit="word">of</span><span begin="2:24:35.240" end="2:24:35.280" podcasts:unit="word">a</span><span begin="2:24:35.280" end="2:24:35.440" podcasts:unit="word">sudden,</span><span begin="2:24:35.440" end="2:24:35.560" podcasts:unit="word">we</span><span begin="2:24:35.560" end="2:24:35.800" podcasts:unit="word">looked</span><span begin="2:24:35.800" end="2:24:35.940" podcasts:unit="word">up</span><span begin="2:24:35.940" end="2:24:36.060" podcasts:unit="word">and</span><span begin="2:24:36.060" end="2:24:36.180" podcasts:unit="word">there</span><span begin="2:24:36.180" end="2:24:36.320" podcasts:unit="word">were</span><span begin="2:24:36.320" end="2:24:37.200" podcasts:unit="word">two</span><span begin="2:24:37.220" end="2:24:37.880" podcasts:unit="word">huge,</span><span begin="2:24:37.880" end="2:24:38.080" podcasts:unit="word">what</span><span begin="2:24:38.080" end="2:24:38.360" podcasts:unit="word">were</span><span begin="2:24:38.360" end="2:24:38.520" podcasts:unit="word">to</span><span begin="2:24:38.520" end="2:24:38.780" podcasts:unit="word">us,</span><span begin="2:24:38.780" end="2:24:39.460" podcasts:unit="word">unidentified</span><span begin="2:24:39.460" end="2:24:40.860" podcasts:unit="word">anomalous</span><span begin="2:24:40.860" end="2:24:42.040" podcasts:unit="word">figures.</span></span><span begin="2:24:42.040" end="2:24:43.420" podcasts:unit="sentence" xml:lang="en"><span begin="2:24:42.040" end="2:24:42.160" podcasts:unit="word">They</span><span begin="2:24:42.160" end="2:24:42.380" podcasts:unit="word">didn't</span><span begin="2:24:42.380" end="2:24:42.540" podcasts:unit="word">look</span><span begin="2:24:42.540" end="2:24:42.660" podcasts:unit="word">so</span><span begin="2:24: