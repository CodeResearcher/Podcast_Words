:59.054" podcasts:unit="word">over</span><span begin="2:24:59.054" end="2:24:59.894" podcasts:unit="word">books.</span></span><span begin="2:24:59.894" end="2:25:07.214" podcasts:unit="sentence" xml:lang="en"><span begin="2:24:59.894" end="2:25:00.134" podcasts:unit="word">If</span><span begin="2:25:00.134" end="2:25:01.374" podcasts:unit="word">religion</span><span begin="2:25:01.374" end="2:25:01.654" podcasts:unit="word">is</span><span begin="2:25:01.654" end="2:25:02.234" podcasts:unit="word">built</span><span begin="2:25:02.234" end="2:25:02.554" podcasts:unit="word">from</span><span begin="2:25:02.554" end="2:25:03.374" podcasts:unit="word">words,</span><span begin="2:25:03.374" end="2:25:03.634" podcasts:unit="word">then</span><span begin="2:25:03.634" end="2:25:04.414" podcasts:unit="word">AI</span><span begin="2:25:04.414" end="2:25:04.674" podcasts:unit="word">will</span><span begin="2:25:04.674" end="2:25:05.014" podcasts:unit="word">take</span><span begin="2:25:05.014" end="2:25:05.734" podcasts:unit="word">over</span><span begin="2:25:05.734" end="2:25:07.214" podcasts:unit="word">religion.</span></span><span begin="2:25:07.214" end="2:25:12.354" podcasts:unit="sentence" xml:lang="en"><span begin="2:25:07.214" end="2:25:07.374" podcasts:unit="word">This</span><span begin="2:25:07.374" end="2:25:07.514" podcasts:unit="word">is</span><span begin="2:25:07.514" end="2:25:08.194" podcasts:unit="word">particularly</span><span begin="2:25:08.194" end="2:25:08.774" podcasts:unit="word">true</span><span begin="2:25:08.774" end="2:25:09.034" podcasts:unit="word">of</span><span begin="2:25:09.034" end="2:25:09.714" podcasts:unit="word">religions</span><span begin="2:25:10.154" end="2:25:10.994" podcasts:unit="word">based</span><span begin="2:25:10.994" end="2:25:11.234" podcasts:unit="word">on</span><span begin="2:25:11.234" end="2:25:12.354" podcasts:unit="word">books.</span></span><span begin="2:25:12.354" end="2:25:16.234" podcasts:unit="sentence" xml:lang="en"><span begin="2:25:12.354" end="2:25:12.614" podcasts:unit="word">Like</span><span begin="2:25:12.614" end="2:25:13.594" podcasts:unit="word">Islam,</span><span begin="2:25:13.594" end="2:25:14.554" podcasts:unit="word">Christianity</span><span begin="2:25:14.554" end="2:25:14.714" podcasts:unit="word">or</span><span begin="2:25:14.714" end="2:25:16.234" podcasts:unit="word">Judaism.</span></span><span begin="2:25:16.234" end="2:25:19.394" podcasts:unit="sentence" xml:lang="en"><span begin="2:25:16.234" end="2:25:16.834" podcasts:unit="word">Judaism</span><span begin="2:25:16.834" end="2:25:17.074" podcasts:unit="word">called</span><span begin="2:25:17.074" end="2:25:17.794" podcasts:unit="word">itself</span><span begin="2:25:17.794" end="2:25:17.934" podcasts:unit="word">the</span><span begin="2:25:17.934" end="2:25:18.434" podcasts:unit="word">religion</span><span begin="2:25:18.434" end="2:25:18.574" podcasts:unit="word">of</span><span begin="2:25:18.574" end="2:25:18.714" podcasts:unit="word">the</span><span begin="2:25:18.714" end="2:25:19.394" podcasts:unit="word">book.</span></span><span begin="2:25:19.394" end="2:25:26.674" podcasts:unit="sentence" xml:lang="en"><span begin="2:25:19.394" end="2:25:19.514" podcasts:unit="word">And</span><span begin="2:25:19.514" end="2:25:19.714" podcasts:unit="word">it</span><span begin="2:25:19.714" end="2:25:20.554" podcasts:unit="word">grants</span><span begin="2:25:20.574" end="2:25:21.274" podcasts:unit="word">ultimate</span><span begin="2:25:21.274" end="2:25:22.414" podcasts:unit="word">authority,</span><span begin="2:25:22.414" end="2:25:22.594" podcasts:unit="word">not</span><span begin="2:25:22.594" end="2:25:22.754" podcasts:unit="word">to</span><span begin="2:25:22.754" end="2:25:23.994" podcasts:unit="word">humans,</span><span begin="2:25:23.994" end="2:25:24.174" podcasts:unit="word">but</span><span begin="2:25:24.174" end="2:25:24.434" podcasts:unit="word">to</span><span begin="2:25:24.434" end="2:25:25.374" p