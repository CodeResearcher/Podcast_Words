" podcasts:unit="word">words</span><span begin="2:24:31.474" end="2:24:31.714" podcasts:unit="word">in</span><span begin="2:24:31.714" end="2:24:32.214" podcasts:unit="word">order</span><span begin="2:24:32.214" end="2:24:32.354" podcasts:unit="word">is</span><span begin="2:24:32.354" end="2:24:33.954" podcasts:unit="word">concerned,</span><span begin="2:24:33.954" end="2:24:34.594" podcasts:unit="word">AI</span><span begin="2:24:34.594" end="2:24:35.374" podcasts:unit="word">already</span><span begin="2:24:35.374" end="2:24:36.054" podcasts:unit="word">thinks</span><span begin="2:24:36.054" end="2:24:37.074" podcasts:unit="word">better</span><span begin="2:24:37.074" end="2:24:37.314" podcasts:unit="word">than</span><span begin="2:24:37.314" end="2:24:37.574" podcasts:unit="word">many</span><span begin="2:24:37.574" end="2:24:37.694" podcasts:unit="word">of</span><span begin="2:24:37.694" end="2:24:38.574" podcasts:unit="word">us.</span></span><span begin="2:24:38.574" end="2:24:47.074" podcasts:unit="sentence" xml:lang="en"><span begin="2:24:38.574" end="2:24:39.554" podcasts:unit="word">Therefore,</span><span begin="2:24:39.554" end="2:24:40.614" podcasts:unit="word">anything</span><span begin="2:24:40.614" end="2:24:41.294" podcasts:unit="word">made</span><span begin="2:24:41.294" end="2:24:41.574" podcasts:unit="word">of</span><span begin="2:24:41.574" end="2:24:42.094" podcasts:unit="word">words</span><span begin="2:24:43.054" end="2:24:43.694" podcasts:unit="word">will</span><span begin="2:24:43.694" end="2:24:43.954" podcasts:unit="word">be</span><span begin="2:24:43.954" end="2:24:44.734" podcasts:unit="word">taken</span><span begin="2:24:44.734" end="2:24:45.454" podcasts:unit="word">over</span><span begin="2:24:45.454" end="2:24:45.954" podcasts:unit="word">by</span><span begin="2:24:45.954" end="2:24:47.074" podcasts:unit="word">AI.</span></span><span begin="2:24:47.074" end="2:24:53.234" podcasts:unit="sentence" xml:lang="en"><span begin="2:24:47.074" e